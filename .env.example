# PostgreSQL
DB_USER=rubbish
DB_PASSWORD=change_me
DB_NAME=rubbish
DB_HOST=db
DB_PORT=5432

# Используется приложением для подключения к БД
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}

# Окружение: production блокирует /testlab и /api/db/* независимо от TESTLAB_ENABLED.
# В docker-compose.yml уже выставлено production — не меняй.
ENVIRONMENT=development

# Тестовая лаборатория (/testlab и /api/db/*).
# Работает только при ENVIRONMENT != production И TESTLAB_ENABLED=1.
TESTLAB_ENABLED=1

# S3-хранилище изображений.
# Локальная разработка: запустить MinIO через `docker compose --profile dev up`,
# затем создать bucket rubbish-detector в веб-консоли (http://localhost:9001).
# Продакшен: заменить на реквизиты Selectel (endpoint из панели управления контейнером).
# Если переменные не заданы, сохранение в S3 пропускается без ошибки.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rubbish-detector
S3_REGION=us-east-1
