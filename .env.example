# PostgreSQL
DB_USER=rubbish
DB_PASSWORD=change_me
DB_NAME=rubbish
DB_HOST=db
DB_PORT=5432

# Используется приложением для подключения к БД
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}

# Окружение: production блокирует /testlab и /api/db/* независимо от TESTLAB_ENABLED.
# В docker-compose.yml уже выставлено production — не меняй.
ENVIRONMENT=development

# Тестовая лаборатория (/testlab и /api/db/*).
# Работает только при ENVIRONMENT != production И TESTLAB_ENABLED=1.
TESTLAB_ENABLED=1
