# PostgreSQL
DB_USER=rubbish
DB_PASSWORD=change_me
DB_NAME=rubbish
DB_HOST=db
DB_PORT=5432

# Используется приложением для подключения к БД
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}

# Тестовая лаборатория (/testlab и /api/db/*)
# Установи 1 для локальной разработки. В продакшне не задавай (или оставь пустой).
TESTLAB_ENABLED=
